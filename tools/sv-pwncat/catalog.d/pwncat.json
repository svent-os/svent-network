{
  "schema": 1,
  "name": "pwncat",
  "group": "network",
  "description": "Interactive shell management framework",
  "packaging": "svent",
  "package": "sv-pwncat",
  "executables": [
    "pwncat-cs"
  ],
  "official_source": "https://github.com/calebstewart/pwncat",
  "version_policy": "svent-packaged",
  "functional_test": [
    "pwncat-cs",
    "--help"
  ],
  "isolation": {
    "kind": "venv",
    "prefix": "/opt/sv-pwncat",
    "python": "/opt/sv-pwncat/bin/python"
  }
}
