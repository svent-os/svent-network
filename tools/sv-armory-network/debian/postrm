#!/bin/sh
set -eu
case "$1" in
    remove|purge)
        /usr/bin/python3 -I - <<'SVENT_NETWORK_CLEANUP'
import hashlib
import json
import pathlib
root = pathlib.Path('/usr/share/armory/network')
state = pathlib.Path('/var/lib/svent/armory-network/managed.json')
if state.is_file() and not state.is_symlink() and not root.is_symlink() and not root.parent.is_symlink():
    for entry in json.loads(state.read_text()):
        relative = pathlib.PurePosixPath(entry['path'])
        if relative.is_absolute() or '..' in relative.parts or '\\' in entry['path']:
            raise RuntimeError('Invalid managed collection path')
        path = root.joinpath(*relative.parts)
        if not path.resolve().is_relative_to(root.resolve()):
            raise RuntimeError('Collection path escapes its directory')
        if path.is_file() and not path.is_symlink() and hashlib.sha256(path.read_bytes()).hexdigest() == entry['sha256']:
            path.unlink()
    for directory in sorted(root.rglob('*'), key=lambda value: len(value.parts), reverse=True):
        if directory.is_dir() and not directory.is_symlink():
            try:
                directory.rmdir()
            except OSError:
                pass
    state.unlink()
    for directory in (state.parent, root):
        try:
            directory.rmdir()
        except OSError:
            pass
SVENT_NETWORK_CLEANUP
        ;;
esac
#DEBHELPER#
