{
  "schema": 1,
  "name": "mitmproxy",
  "group": "network",
  "description": "Interactive HTTP and TLS proxy suite",
  "packaging": "svent",
  "package": "sv-mitmproxy",
  "executables": [
    "mitmproxy",
    "mitmdump",
    "mitmweb"
  ],
  "official_source": "https://mitmproxy.org",
  "version_policy": "svent-packaged",
  "functional_test": [
    "mitmproxy",
    "--help"
  ],
  "isolation": {
    "kind": "venv",
    "prefix": "/opt/sv-mitmproxy",
    "python": "/opt/sv-mitmproxy/bin/python"
  }
}
